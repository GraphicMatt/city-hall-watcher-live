ADMIN_PASSWORD=dev-password
JWT_SECRET=replace-me-with-at-least-32-random-characters
CRON_SECRET=dev-cron-secret

# Optional Web Push. Generate once with: npx web-push generate-vapid-keys --json
# Keep the private key server-side. Leave unset to disable notification opt-ins.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
